# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repo.
# docker-compose.yml lee estas variables.

# --- Docker (obligatorias) ---
POSTGRES_PASSWORD=
EVOLUTION_API_KEY=
# Zona horaria de operación (por defecto America/La_Paz)
TZ_OPERACION=

# --- Referencia (las credenciales reales viven en n8n, no aquí) ---
# n8n: "Postgres credencial" (host postgres, base ventas), "evolution-apikey" (header apikey),
# "gemini-api-vieja" / "gemini-api-viejanga" (Gemini), "panel-api-key" (header X-Panel-Key).

# WhatsApp Cloud API (alternativa futura a Evolution)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# n8n
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_BASE_URL=
